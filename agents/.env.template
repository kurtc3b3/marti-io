# Application
APP_ENV=development
APP_NAME=Daily Agent Hub
API_PREFIX=/api
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# CORS (comma-separated)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Rate limits (slowapi — REST endpoints only)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=20/minute

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Postgres checkpointer (LangGraph thread memory)
CHECKPOINTER=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents

# SQLite fallback (set CHECKPOINTER=sqlite)
SQLITE_PATH=./data/checkpoints.db

# Redis (WebSocket pub/sub)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_PAYLOADS=true
LOG_HTTP_PAYLOADS=true

# Static files (built from web/ — leave unset to use src/agents/static)
# STATIC_DIR=
